{
  "title": "01 Resolve tenant owner activation",
  "request": {
    "method": "POST",
    "url": "https://platform.example.com/api/account-actions/v1/resolve",
    "headers": {
      "Content-Type": "application/json",
      "Accept": "*/*"
    },
    "body": {
      "token": "<activation-token>"
    }
  },
  "response": {
    "status": "OK",
    "code": 200,
    "headers": {
      "Content-Type": "application/json"
    },
    "body": {
      "action": {
        "invitationId": "00000000-0000-4000-8000-000000000000",
        "action": "tenant.onboarding",
        "expiresAt": "2027-01-01T00:00:00Z",
        "requiresPassword": true
      }
    }
  }
}
