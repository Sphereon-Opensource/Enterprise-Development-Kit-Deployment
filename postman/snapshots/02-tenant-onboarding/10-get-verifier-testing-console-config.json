{
  "title": "10 Get verifier testing-console config",
  "request": {
    "method": "GET",
    "url": "https://platform.example.com/api/platform/config/v1/tenants/00000000-0000-4000-8000-000000000000/oid4vp/verifier/instances/acme/testing-console",
    "headers": {
      "Authorization": "Bearer <token>",
      "Accept": "*/*"
    }
  },
  "response": {
    "status": "OK",
    "code": 200,
    "headers": {
      "Content-Type": "application/json"
    },
    "body": {
      "enabled": {
        "value": true,
        "source": "tenant"
      },
      "exposureMode": {
        "value": "public",
        "source": "tenant"
      },
      "publicBaseUrl": "https://acme.example.com/oid4vp/acme",
      "displayUrl": "https://acme.example.com/testing-console/verifier/acme?publicBaseUrl=https%3A%2F%2Facme.example.com%2Foid4vp%2Facme"
    }
  }
}
