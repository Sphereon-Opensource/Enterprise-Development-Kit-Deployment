{
  "title": "05a Fetch credential nonce",
  "request": {
    "method": "POST",
    "url": "https://acme.example.com/oid4vci/acme/oid4vci/nonce",
    "headers": {
      "Accept": "*/*"
    }
  },
  "response": {
    "status": "OK",
    "code": 200,
    "headers": {
      "Content-Type": "application/json"
    },
    "body": {
      "c_nonce": "<nonce>",
      "c_nonce_expires_in": 300
    }
  }
}
