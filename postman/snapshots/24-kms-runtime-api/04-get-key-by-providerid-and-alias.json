{
  "title": "04 Get key by providerId and alias",
  "request": {
    "method": "GET",
    "url": "https://rc4customer.example.com/api/kms/v1/providers/default/keys/customer-runtime-signing-key",
    "headers": {
      "Authorization": "Bearer <token>",
      "Accept": "*/*"
    }
  },
  "response": {
    "status": "OK",
    "code": 200,
    "headers": {
      "Content-Type": "application/json"
    },
    "body": {
      "keyInfo": {
        "key": {
          "kty": "EC",
          "kid": "<key-id>",
          "crv": "P-256",
          "x": "<public-key-material>",
          "y": "<public-key-material>",
          "x5c": [
            "<certificate>"
          ]
        },
        "alias": "customer-runtime-signing-key",
        "providerId": "default",
        "kid": "<key-id>",
        "signatureAlgorithm": "ECDSA_SHA256",
        "x5c": [
          "<certificate>"
        ],
        "keyType": "EC",
        "keyEncoding": "JOSE"
      }
    }
  }
}
