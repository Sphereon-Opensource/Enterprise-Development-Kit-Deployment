{
  "title": "00 Get tenant secret options",
  "request": {
    "method": "GET",
    "url": "https://platform.example.com/api/platform/config/v1/tenants/00000000-0000-4000-8000-000000000000/secrets/options",
    "headers": {
      "Authorization": "Bearer <token>",
      "Accept": "*/*"
    }
  },
  "response": {
    "status": "OK",
    "code": 200,
    "headers": {
      "Content-Type": "application/json"
    },
    "body": {
      "effectivePolicy": {
        "allowTenantManagedProviders": false,
        "allowPlatformOfferings": true,
        "requireBackendIsolation": true,
        "allowedProviderTypes": [
          "kms"
        ],
        "retentionDays": 30,
        "version": 2
      },
      "permittedOfferings": [
        {
          "offeringId": "spo_default_tenant_kms",
          "preflightEtag": "\"1\"",
          "displayName": "Isolated tenant KMS",
          "capabilities": [
            "backend-tenant-isolation",
            "credential-rotation",
            "delete",
            "read",
            "versioning",
            "write"
          ],
          "isolationMode": "tenant-key",
          "usageState": "selected",
          "migrationAllowed": false,
          "migrationBlockedReason": "already-selected"
        }
      ],
      "tenantManagedProviderSetups": []
    }
  }
}
