{
  "title": "05 Create raw signature with providerId and alias",
  "request": {
    "method": "POST",
    "url": "https://acme.example.com/api/kms/v1/signatures/raw/create",
    "headers": {
      "Content-Type": "application/json",
      "Authorization": "Bearer <token>",
      "Accept": "*/*"
    },
    "body": {
      "keyInfo": {
        "providerId": "default",
        "alias": "customer-runtime-signing-key"
      },
      "input": "aGVsbG8="
    }
  },
  "response": {
    "status": "Created",
    "code": 201,
    "headers": {
      "Content-Type": "application/json"
    },
    "body": {
      "signature": "<signature>"
    }
  }
}
