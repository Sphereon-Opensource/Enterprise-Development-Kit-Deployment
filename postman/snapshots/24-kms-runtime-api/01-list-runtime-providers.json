{
  "title": "01 List runtime providers",
  "request": {
    "method": "GET",
    "url": "https://acme.example.com/api/kms/v1/providers",
    "headers": {
      "Authorization": "Bearer <token>",
      "Accept": "*/*"
    }
  },
  "response": {
    "status": "OK",
    "code": 200,
    "headers": {
      "Content-Type": "application/json"
    },
    "body": {
      "providers": [
        {
          "providerId": "default",
          "type": "SOFTWARE",
          "displayName": "Software KMS",
          "ownership": "TENANT",
          "sharedFromPlatform": false,
          "isDefault": true
        }
      ]
    }
  }
}
