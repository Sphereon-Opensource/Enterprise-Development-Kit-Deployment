{
  "title": "00 List platform secret offerings",
  "request": {
    "method": "GET",
    "url": "https://platform.example.com/api/platform/admin/v1/application/secrets/offerings",
    "headers": {
      "Authorization": "Bearer <token>",
      "Accept": "*/*"
    }
  },
  "response": {
    "status": "OK",
    "code": 200,
    "headers": {
      "Content-Type": "application/json"
    },
    "body": [
      {
        "offeringId": "spo_default_tenant_kms",
        "displayName": "Isolated tenant KMS",
        "offeringRevision": 1,
        "capabilities": [
          "backend-tenant-isolation",
          "credential-rotation",
          "delete",
          "read",
          "versioning",
          "write"
        ],
        "isolationMode": "tenant-key",
        "enabled": true,
        "assignmentCount": 3,
        "state": "active",
        "version": 1
      }
    ]
  }
}
