{
  "title": "12 Resolve activation-created DID",
  "request": {
    "method": "GET",
    "url": "https://acme.example.com/api/did/v1/identifiers/did%3Aweb%3Aacme.example.com",
    "headers": {
      "Authorization": "Bearer <token>",
      "Accept": "*/*"
    }
  },
  "response": {
    "status": "OK",
    "code": 200,
    "headers": {
      "Content-Type": "application/json"
    },
    "body": {
      "did": "did:web:acme.example.com",
      "method": "web",
      "alias": "acme",
      "role": "EXTERNAL",
      "createdAt": "2026-01-01T00:00:00Z",
      "updatedAt": "2026-01-01T00:00:00Z"
    }
  }
}
