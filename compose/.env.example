# EDK enterprise Docker Compose environment.
# Copy to .env and fill in the values for your deployment.
#   cp .env.example .env

# --- Image source -----------------------------------------------------------
# Registry and tag for the published enterprise images. Run `docker login`
# against this registry first so the pull succeeds.
EDK_REGISTRY=nexus.sphereon.com/edk-docker
EDK_TAG=0.25.0-SNAPSHOT

# --- Deployment identity ----------------------------------------------------
# Deployment id the license is bound to. Must match the id your license token
# was minted with.
EDK_DEPLOYMENT_ID=deployment-1
# prod requires the operator invitation flow. dev unlocks the break-glass
# operator credential below; use dev only for evaluation.
EDK_DEPLOYMENT_MODE=prod
# Platform operator identity used by setup/onboarding. For local evaluation this
# must match the operator account used by the Postman environment or provisioning
# script.
EDK_PLATFORM_OPERATOR_EMAIL=operator@example.com

# --- Run modes --------------------------------------------------------------
# Two ways to run the stack:
#
#   1. Base file alone:
#        docker compose -f docker-compose.yml up -d
#      Each service is published on its own host port (see Host port mapping
#      below). The EDK_*_EXTERNAL_BASE_URL values below default to those local
#      loopback origins and are suitable for local evaluation only.
#
#   2. Base file plus the single-port gateway overlay:
#        docker compose -f docker-compose.yml -f docker-compose.gateway.yml up -d
#      A Traefik reverse proxy terminates TLS on one port (443), preserves the
#      Host header, and fans out to the services by host and path. The overlay
#      derives the bootstrap/operator URLs from EDK_PLATFORM_BASE_DOMAIN. Tenant
#      protocol URLs are not configured here; they are created as tenant public
#      endpoint bindings during onboarding, normally all on
#      https://<tenant-slug>.<base-domain>.

# --- Public hostnames -------------------------------------------------------
# Base domain under which tenants resolve by subdomain. The operator host is
# platform.<base> and each tenant is reached at <tenant>.<base>.
#
# For local evaluation with the single-port gateway, leave this as
# saas.localtest.me (every subdomain resolves to 127.0.0.1). For a real
# deployment, set your own base domain.
EDK_PLATFORM_BASE_DOMAIN=saas.localtest.me
# First tenant slug used by local provisioning examples and the customer
# Postman collection. Tenant public endpoints are normally bound as
# https://<tenant-slug>.<base-domain>.
EDK_TENANT_SLUG=acme

# External base URLs the services advertise before tenant public-endpoint
# bindings exist. For the base compose file alone, keep these on the loopback
# ports below. For a customer-managed reverse proxy without the bundled gateway
# overlay, set them to the actual public origins that proxy preserves in
# Host/X-Forwarded-Proto.
#
# In the bundled single-port gateway mode, leave these as-is. The overlay
# overrides the bootstrap/operator origins, and tenant URLs are bound by
# scripts/provision.* or the Postman collection as https://<tenant>.<base-domain>.
EDK_PLATFORM_EXTERNAL_BASE_URL=http://localhost:18080
EDK_TENANT_AS_EXTERNAL_BASE_URL=http://localhost:18083
EDK_DID_EXTERNAL_BASE_URL=http://localhost:18082
EDK_ISSUER_EXTERNAL_BASE_URL=http://localhost:18084
EDK_VERIFIER_EXTERNAL_BASE_URL=http://localhost:18085

# External origin that serves the operator/admin UI and the platform setup-API
# CORS allow-list. Normally the platform external URL; the gateway overlay sets
# it to the gateway operator host. Note: the operator-cli OAuth redirect_uri is
# now based on the platform EXTERNAL_BASE_URL (the admin console is served
# same-origin at {host}/admin-console/callback), not on this value.
EDK_ONBOARDING_UI_EXTERNAL_BASE_URL=http://localhost:18080

# --- Admin console ----------------------------------------------------------
# The platform admin console (sphereon/admin-console, sharing EDK_REGISTRY and
# EDK_TAG above) is a Next.js standalone app served under /admin on the platform
# host. It is reached only through the single-port gateway, so it needs no host
# port by default. Uncomment the commented ports mapping and this var to expose
# the standalone server directly for local debugging.
# EDK_ADMIN_CONSOLE_HOST_PORT=13000

# Internal-only tenant-KMS base URL. Stays on the compose network; not published.
EDK_KMS_INTERNAL_BASE_URL=http://enterprise-tenant-kms:8080

# Single-port multi-tenant mode: trust per-tenant AS issuers from active
# registry bindings. Leave false unless you front the stack with the single-port
# gateway.
EDK_TRUST_TENANT_REGISTRY_ISSUERS=false

# --- Host port mapping ------------------------------------------------------
# Host ports the REST surfaces are published on. tenant-KMS is intentionally
# absent: it has no host port and stays internal.
EDK_PLATFORM_HOST_PORT=18080
EDK_DID_HOST_PORT=18082
EDK_AS_HOST_PORT=18083
EDK_ISSUER_HOST_PORT=18084
EDK_VERIFIER_HOST_PORT=18085
EDK_POSTGRES_HOST_PORT=15432

# --- Observability ----------------------------------------------------------
# The compose stack deploys an OpenTelemetry Collector and Jaeger by default.
# Services use the otlp-all preset in their application.yml files: traces and
# metrics export to the collector, and traces are visible in Jaeger.
EDK_OTEL_COLLECTOR_GRPC_HOST_PORT=4317
EDK_OTEL_COLLECTOR_HTTP_HOST_PORT=4318
EDK_JAEGER_UI_HOST_PORT=16686
# In-container collector endpoints. Override only when sending telemetry to an
# external collector.
EDK_OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
EDK_OTEL_EXPORTER_OTLP_PROTOCOL=grpc
EDK_OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://otel-collector:4317
EDK_OTEL_EXPORTER_OTLP_TRACES_PROTOCOL=grpc
EDK_OTEL_EXPORTER_OTLP_METRICS_ENDPOINT=http://otel-collector:4317
EDK_OTEL_EXPORTER_OTLP_METRICS_PROTOCOL=grpc

# --- Database ---------------------------------------------------------------
EDK_DB_NAME=edk
EDK_DB_USERNAME=edk
# REQUIRED: set a strong password.
EDK_DB_PASSWORD=

# --- Secrets ----------------------------------------------------------------
# REQUIRED: password protecting the software KMS keystore.
EDK_KEYSTORE_PASSWORD=
# REQUIRED: shared secret the internal service clients (issuer/kms/did/verifier)
# present to the tenant AS for client_credentials.
EDK_INTERNAL_CLIENT_SECRET=
# REQUIRED: initial break-glass operator credential (dev deployment mode only).
# Leave empty in prod; operators are provisioned through the invitation flow.
EDK_OWNER_INITIAL_CREDENTIAL=

# Issuer pipeline session-encryption keys (base64url, 32 bytes each). REQUIRED
# for the issuer. Generate unique values per deployment, for example:
#   openssl rand -base64 32 | tr '+/' '-_' | tr -d '='
EDK_PIPELINE_MASTER_KEK=
EDK_PIPELINE_BLIND_INDEX_KEY=

# --- Secret backend ---------------------------------------------------------
# Backend that resolves admin and onboarding secrets. config-system-dev-only
# reads them from config and is for evaluation. Select a managed backend for
# production.
EDK_SECRET_BACKEND=config-system-dev-only

# --- License ----------------------------------------------------------------
# License setup. By default the platform starts with the setup gate open and the
# operator installs a license through /setup-license. The setup API creates the
# local license-recipient key when it generates the license request, stores it in
# a Docker volume, and includes only the public key in the request artifact.
#
# For non-production/customer-evaluation test licenses that do not chain to the
# embedded production root, set:
#   EDK_DEPLOYMENT_MODE=dev
#   EDK_LICENSE_TRUST_EMBEDDED=false
# and paste the supplied test root CA bundle in /setup-license. The setup API
# stores it in the durable license-recipient Docker volume as:
#   /app/license/license-root-ca.pem
#
# Do not use file-based trust with EDK_DEPLOYMENT_MODE=prod/on-prem; the runtime
# intentionally rejects that combination.
#
# The recipient key id must match the key id inside the license-recipient JWK
# and the issued license token recipient.
EDK_LICENSE_RECIPIENT_KEY_ID=license-recipient
# Leave true when the license chains to the embedded product root. Set false
# only in dev/test-license mode; the setup UI then accepts and persists the test
# root CA bundle in the license volume.
EDK_LICENSE_TRUST_EMBEDDED=true

# Offline bootstrap only. Leave these commented for the setup UI path. Use them
# with docker-compose.offline.yml when Sphereon has already issued a token to a
# recipient key you provide under compose/config/.
# EDK_LICENSE_TOKEN_PATH=./config/license-token.txt
# EDK_LICENSE_RECIPIENT_KEY_PATH=./config/license-recipient.jwk.json
