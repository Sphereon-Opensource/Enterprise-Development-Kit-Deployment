# EDK enterprise Docker Compose customer environment.
# Copy to .env and fill in the values for your deployment. This file contains
# customer-owned setup inputs only. Direct container ports, local diagnostic
# origins, and internal service URLs use docker-compose.yml defaults or gateway
# overlay values and should not be configured here.
#   cp .env.example .env

# --- Image source -----------------------------------------------------------
# Tag for the published enterprise images. Docker Compose image references are
# fixed to nexus.sphereon.com/edk-docker in docker-compose.yml so a local .env
# value cannot accidentally point enterprise image pulls at public Docker Hub.
EDK_TAG=latest

# --- Deployment mode --------------------------------------------------------
# prod requires the operator invitation flow. dev unlocks the break-glass
# operator credential below; use dev only for evaluation.
EDK_DEPLOYMENT_MODE=prod

# --- Public hostnames -------------------------------------------------------
# Base domain under which tenants resolve by subdomain. The platform/operator
# host is platform.<base-domain>. Tenant hosts are chosen during onboarding and
# are reached as <tenant-slug>.<base-domain>.
#
# For local evaluation with the single-port gateway, leave this as
# saas.localtest.me (every subdomain resolves to 127.0.0.1). For a real
# deployment, set your own base domain.
EDK_PLATFORM_BASE_DOMAIN=saas.localtest.me

# --- Databases --------------------------------------------------------------
# Enterprise deployments must use two separate PostgreSQL databases:
#   1. platform/control-plane DB: tenant registry, public endpoints, platform
#      config, license state, platform tenant, and platform AS/operator state.
#   2. tenant workload DB: per-tenant runtime data, isolated by tenant schema.
# Do not point these variables at the same database in an enterprise deployment.
EDK_PLATFORM_DB_NAME=platform
EDK_PLATFORM_DB_USERNAME=edk_platform
# REQUIRED: set a strong platform DB password.
EDK_PLATFORM_DB_PASSWORD=

EDK_TENANT_DB_NAME=tenant
EDK_TENANT_DB_USERNAME=edk_tenant
# REQUIRED: set a strong tenant DB password, distinct from the platform DB password.
EDK_TENANT_DB_PASSWORD=

# --- Secrets ----------------------------------------------------------------
# REQUIRED: password protecting the software KMS keystore.
EDK_KEYSTORE_PASSWORD=
# REQUIRED: shared secret the internal service clients (issuer/kms/did/verifier)
# present to the tenant AS for client_credentials.
EDK_INTERNAL_CLIENT_SECRET=
# REQUIRED: initial break-glass operator credential (dev deployment mode only).
# Leave empty in prod; operators are provisioned through the invitation flow.
EDK_OWNER_INITIAL_CREDENTIAL=

# Issuer pipeline session-encryption keys (base64url, 32 bytes each). REQUIRED
# for the issuer. Generate unique values per deployment, for example:
#   openssl rand -base64 32 | tr '+/' '-_' | tr -d '='
# Please replace the below defaults!
EDK_PIPELINE_MASTER_KEK=9rA4YvY5MJHr9VNwBw8jK-3m6DnQQ30hkzIi7Fu3z3I
EDK_PIPELINE_BLIND_INDEX_KEY=hTOiPZSnQtL3eL_XLJR46xbvCrKmh6equWPqukhTVEA

# --- Secret backend ---------------------------------------------------------
# Backend that resolves admin and onboarding secrets. config-system-dev-only
# reads them from config and is for evaluation. Select a managed backend for
# production.
EDK_SECRET_BACKEND=config-system-dev-only

# --- License ----------------------------------------------------------------
# Normal first-run setup requires no license environment variables. The operator
# imports the protected license bundle through the setup API after the stack is
# running. The setup flow creates and stores the local license-recipient key and
# the signed bundle supplies the installation id.

# Offline bootstrap only. Leave these commented for the setup UI path. Use them
# with docker-compose.offline.yml when Sphereon has already issued a token to a
# recipient key you provide under compose/config/.
# EDK_LICENSE_TOKEN_PATH=./config/license-token.txt
# EDK_LICENSE_RECIPIENT_KEY_PATH=./config/license-recipient.jwk.json
