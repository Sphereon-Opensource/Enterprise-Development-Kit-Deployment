# EDK enterprise Docker Compose environment.
#
#   1. Copy this file to .env and set EDK_TAG and EDK_PLATFORM_BASE_DOMAIN.
#   2. Generate the secret-authority key set with
#      scripts/generate-secret-authority-keys.(ps1|sh).
#   3. Run: node scripts/generate-compose-secrets.mjs
#      It fills every empty secret below, copies the secret-authority
#      coordinates from the generated window.env, and never changes a value
#      that is already set.
#
# Keep .env private and back it up together with the databases and keystores.
# Direct container ports and internal service URLs keep their docker-compose.yml
# defaults and are not configured here.

# --- Release ----------------------------------------------------------------
# Approved image tag. Images always come from nexus.sphereon.com/edk-docker.
EDK_TAG=

# --- Public hostnames -------------------------------------------------------
# Installation base domain. The platform is served at platform.<base-domain>
# and each tenant at <tenant-slug>.<base-domain>. Use saas.localtest.me only
# for local evaluation with the bundled gateway; it resolves to 127.0.0.1.
EDK_PLATFORM_BASE_DOMAIN=

# --- Deployment mode --------------------------------------------------------
# prod requires the operator invitation flow. dev enables the break-glass
# operator credential below and is for local evaluation only.
EDK_DEPLOYMENT_MODE=prod
# Break-glass operator credential, read only in dev mode. Leave empty in prod.
EDK_OWNER_INITIAL_CREDENTIAL=

# --- Databases --------------------------------------------------------------
# Two separate PostgreSQL databases: the platform database (tenant registry,
# platform configuration, license and operator state) and the tenant workload
# database (per-tenant runtime data in one schema per tenant). Never point both
# at the same database.
EDK_PLATFORM_DB_NAME=platform
EDK_PLATFORM_DB_USERNAME=edk_platform
# Generated. Owner password of the platform database.
EDK_PLATFORM_DB_PASSWORD=
EDK_TENANT_DB_NAME=tenant
EDK_TENANT_DB_USERNAME=edk_tenant
# Generated. Owner password of the tenant database.
EDK_TENANT_DB_PASSWORD=
# Generated. Passwords of the three restricted secret-management roles that
# exist in both databases: secret_management_admin (platform only),
# secret_management_tenant_serving and secret_management_runtime.
EDK_SECRET_MANAGEMENT_ADMIN_DB_PASSWORD=
EDK_SECRET_MANAGEMENT_TENANT_DB_PASSWORD=
EDK_SECRET_MANAGEMENT_RUNTIME_DB_PASSWORD=

# --- Service secrets (generated) --------------------------------------------
# Password of the platform and tenant software KMS keystores.
EDK_KEYSTORE_PASSWORD=
# Client secret of each internal service client registered at the platform.
# The platform reads all of them; each service container receives only its own.
EDK_INTERNAL_CLIENT_SECRET_TENANT_KMS=
EDK_INTERNAL_CLIENT_SECRET_TENANT_AS=
EDK_INTERNAL_CLIENT_SECRET_DID=
EDK_INTERNAL_CLIENT_SECRET_BLOB=
EDK_INTERNAL_CLIENT_SECRET_ISSUER=
EDK_INTERNAL_CLIENT_SECRET_VERIFIER=
# Client secret of the platform admin console backend.
EDK_ADMIN_CONSOLE_WORKLOAD_CLIENT_SECRET=
# Issuer pipeline session encryption keys (32 bytes, base64url).
EDK_PIPELINE_MASTER_KEK=
EDK_PIPELINE_BLIND_INDEX_KEY=
# Tenant authorization server federation session key (32 bytes, base64), used
# when a tenant signs users in through an external identity provider.
EDK_FEDERATION_SESSION_ENCRYPTION_KEY=

# --- Secret authority -------------------------------------------------------
# Directory written by generate-secret-authority-keys, relative to compose/.
EDK_SECRET_AUTHORITY_ROOT=./.secret-authority/current
# Copied from <EDK_SECRET_AUTHORITY_ROOT>/window.env by generate-compose-secrets.mjs.
# Do not edit these coordinate strings.
SECRET_AUTHORITY_CENTRAL_PERMIT_SIGNING_KEY=
SECRET_AUTHORITY_CENTRAL_ASSERTION_VERIFICATION_KEYS=
SECRET_AUTHORITY_SATELLITE_ASSERTION_SIGNING_KEY=
SECRET_AUTHORITY_SATELLITE_PERMIT_VERIFICATION_KEYS=

# --- Optional: platform-shared cloud KMS ------------------------------------
# Declares an Azure Key Vault, an AWS KMS, or both at deployment time and offers
# them to tenants, who enable one by its provider id (azure-shared-signing,
# aws-shared-signing). Tenants can also connect their own vault through the API.
# Uncomment the block of each cloud you use, select the matching manifest, and
# rerun generate-compose-secrets.mjs; it writes the digest of that manifest.
# The platform does not start when a selected manifest lists an empty variable.
#   Azure only: ./config/secret-management-environment.azure.manifest
#   AWS only:   ./config/secret-management-environment.aws.manifest
#   Both:       ./config/secret-management-environment.azure-aws.manifest
# EDK_SECRET_MANAGEMENT_ENVIRONMENT_MANIFEST=./config/secret-management-environment.azure.manifest
# EDK_PLATFORM_KMS_AZURE_KIND=AZURE_KEY_VAULT
# EDK_PLATFORM_KMS_AZURE_VAULT_URI=https://<vault-name>.vault.azure.net
# EDK_PLATFORM_KMS_AZURE_TENANT_ID=<entra-directory-id>
# EDK_PLATFORM_KMS_AZURE_CLIENT_ID=<app-registration-client-id>
# EDK_PLATFORM_KMS_AZURE_CLIENT_SECRET=<app-registration-client-secret>
# EDK_PLATFORM_KMS_AZURE_SHARED_TENANTS=*
# EDK_PLATFORM_KMS_AWS_KIND=AWS_KMS
# EDK_PLATFORM_KMS_AWS_REGION=<region>
# EDK_PLATFORM_KMS_AWS_ACCESS_KEY_ID=<access-key-id>
# EDK_PLATFORM_KMS_AWS_SECRET_ACCESS_KEY=<secret-access-key>
# EDK_PLATFORM_KMS_AWS_SHARED_TENANTS=*
