# Operator-only inputs for the explicit post-provision WeBuild trust-domain
# command. Compose does not run this command automatically because its install
# path cannot safely assume that an authenticated platform credential exists.
# Keep this file free of token values and keep it outside rendered service
# configuration. Set TRUST_DOMAIN_OPERATOR_TOKEN_FILE from a protected runtime
# secret file before invoking the command.

TRUST_DOMAIN_BOOTSTRAP_MODE=
TRUST_DOMAIN_API_BASE_URL=
TRUST_DOMAIN_DOMAIN_ID=
TRUST_DOMAIN_ALLOW_INSECURE_HTTP=false
TRUST_DOMAIN_OPERATOR_TOKEN_FILE=

# EU is a product-fixed TS 119 612 singleton. Only enabled and If-Match are
# accepted. There is intentionally no EU URL variable.
TRUST_DOMAIN_EU_ENABLED=
TRUST_DOMAIN_EU_IF_MATCH=

# The WeBuild test source is a custom TS 119 612 LoTL. Supply all values from
# the consortium/operator source of truth. The script fixes format to XML.
WEBUILD_TRUST_DOMAIN_SOURCE_ID=
WEBUILD_TRUST_DOMAIN_URL=
WEBUILD_TRUST_DOMAIN_SCHEME_IDENTITY=
WEBUILD_TRUST_DOMAIN_ALLOWED_HOST=
WEBUILD_TRUST_DOMAIN_SIGNER_ANCHOR_IDS=
WEBUILD_TRUST_DOMAIN_ENABLED=
WEBUILD_TRUST_DOMAIN_IF_MATCH=
