{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["global"],
  "additionalProperties": true,
  "properties": {
    "global": {
      "type": "object",
      "required": ["platformBaseDomain"],
      "additionalProperties": true,
      "properties": {
        "imageRegistry": {
          "type": "string",
          "minLength": 1,
          "not": {
            "pattern": "^(sphereon(?:/|$)|(?:docker\\.io|index\\.docker\\.io|registry-1\\.docker\\.io)(?:/|$))"
          }
        },
        "imageTag": { "type": "string", "minLength": 1 },
        "imagePullPolicy": { "type": "string", "enum": ["Always", "IfNotPresent", "Never"] },
        "imagePullSecrets": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "platformBaseDomain": { "type": "string", "minLength": 1 },
        "hostAliases": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["ip", "hostnames"],
            "properties": {
              "ip": { "type": "string", "minLength": 1 },
              "hostnames": {
                "type": "array",
                "minItems": 1,
                "items": { "type": "string", "minLength": 1 }
              }
            }
          }
        }
      }
    },
    "topology": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode"],
      "properties": {
        "mode": { "type": "string", "enum": ["distributed", "monolith"] }
      }
    },
    "monolith": {
      "type": "object",
      "additionalProperties": false,
      "required": ["image", "imageTag", "replicas", "restPort", "resources", "env"],
      "properties": {
        "image": { "type": "string", "minLength": 1 },
        "imageTag": { "type": "string" },
        "replicas": { "type": "integer", "minimum": 1 },
        "restPort": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "resources": { "type": "object" },
        "env": { "type": "array", "items": { "type": "object" } }
      }
    },
    "database": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "enabled": { "type": "boolean" },
        "dialect": { "type": "string", "enum": ["postgresql"] },
        "platform": { "$ref": "#/definitions/databaseEndpoint" },
        "secretManagement": {
          "type": "object",
          "additionalProperties": false,
          "required": ["existingSecret", "adminPasswordKey", "tenantPasswordKey"],
          "properties": {
            "existingSecret": { "type": "string", "minLength": 1 },
            "adminPasswordKey": { "type": "string", "minLength": 1 },
            "tenantPasswordKey": { "type": "string", "minLength": 1 }
          }
        },
        "maintenance": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "host": { "type": "string" },
            "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
            "database": { "type": "string", "minLength": 1 },
            "existingSecret": { "type": "string" },
            "usernameKey": { "type": "string", "minLength": 1 },
            "passwordKey": { "type": "string", "minLength": 1 }
          }
        },
        "tenant": {
          "allOf": [
            { "$ref": "#/definitions/databaseEndpoint" },
            {
              "type": "object",
              "additionalProperties": true,
              "properties": {
                "isolation": { "type": "string", "enum": ["schema", "shared", "database", "host"] },
                "schemaPattern": { "type": "string", "minLength": 1 },
                "databasePattern": { "type": "string", "minLength": 1 }
              }
            }
          ]
        },
        "trustDomain": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "isolation": { "type": "string", "enum": ["schema", "shared", "database", "host"] },
            "schemaPattern": { "type": "string", "minLength": 1 },
            "host": { "type": "string" },
            "port": { "type": "integer", "minimum": 0, "maximum": 65535 },
            "name": { "type": "string" },
            "existingSecret": { "type": "string" },
            "usernameKey": { "type": "string", "minLength": 1 },
            "passwordKey": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "secretManagement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["egress", "bootstrap", "authority", "internalResolution", "kubernetesMount"],
      "properties": {
        "egress": {
          "type": "object",
          "additionalProperties": false,
          "required": ["allowedHttpsPorts", "privateEndpointAllowlist"],
          "properties": {
            "allowedHttpsPorts": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "integer",
                "minimum": 1,
                "maximum": 65535
              }
            },
            "privateEndpointAllowlist": {
              "type": "object",
              "maxProperties": 10000,
              "propertyNames": {
                "anyOf": [
                  {
                    "pattern": "^(?:\\*\\.)?[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?(?:\\.[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?)+$"
                  },
                  {
                    "pattern": "^(?:25[0-5]|2[0-4][0-9]|1?[0-9]{1,2})(?:\\.(?:25[0-5]|2[0-4][0-9]|1?[0-9]{1,2})){3}$"
                  },
                  {
                    "minLength": 2,
                    "maxLength": 45,
                    "pattern": "^[0-9A-Fa-f]*:[0-9A-Fa-f:]*$"
                  }
                ]
              },
              "additionalProperties": {
                "type": "array",
                "minItems": 1,
                "maxItems": 32,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "oneOf": [
                    {
                      "pattern": "^(?:25[0-5]|2[0-4][0-9]|1?[0-9]{1,2})(?:\\.(?:25[0-5]|2[0-4][0-9]|1?[0-9]{1,2})){3}/(?:[89]|[12][0-9]|3[0-2])$"
                    },
                    {
                      "minLength": 4,
                      "maxLength": 64,
                      "pattern": "^[0-9A-Fa-f]*:[0-9A-Fa-f:]*/(?:1[6-9]|[2-9][0-9]|1[01][0-9]|12[0-8])$"
                    }
                  ]
                }
              }
            }
          }
        },
        "bootstrap": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kek"],
          "properties": {
            "kek": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "mode",
                "identity",
                "version",
                "kmsProviderId",
                "idempotencyMacKey"
              ],
              "properties": {
                "mode": { "type": "string", "const": "SOFTWARE_KMS" },
                "identity": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$"
                },
                "version": { "type": "integer", "minimum": 1 },
                "kmsProviderId": {
                  "type": "string",
                  "const": "software"
                },
                "idempotencyMacKey": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$"
                }
              }
            }
          }
        },
        "authority": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "platformStorageKmsProviderId",
            "platformStorageKmsBindingKey",
            "defaultTenantOfferingKmsProviderId",
            "defaultTenantOfferingKmsBindingTemplate",
            "allowTenantManagedProviders",
            "allowPlatformOfferings",
            "retentionDays"
          ],
          "properties": {
            "platformStorageKmsProviderId": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
            },
            "platformStorageKmsBindingKey": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,199}$"
            },
            "defaultTenantOfferingKmsProviderId": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
            },
            "defaultTenantOfferingKmsBindingTemplate": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,199}$"
            },
            "allowTenantManagedProviders": { "type": "boolean" },
            "allowPlatformOfferings": { "type": "boolean" },
            "retentionDays": { "type": "integer", "minimum": 1, "maximum": 3650 }
          }
        },
        "internalResolution": {
          "type": "object",
          "additionalProperties": false,
          "required": ["expectedAudience", "allowedServiceActors"],
          "properties": {
            "expectedAudience": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,199}$"
            },
            "allowedServiceActors": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,199}$"
              }
            }
          }
        },
        "kubernetesMount": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled", "existingSecret", "manifest", "manifestSha256"],
          "properties": {
            "enabled": { "type": "boolean" },
            "existingSecret": { "type": "string" },
            "manifest": {
              "type": "object",
              "propertyNames": {
                "pattern": "^sec_[A-Za-z0-9_-]{16,128}$"
              },
              "additionalProperties": {
                "type": "string",
                "maxLength": 255,
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*(/[A-Za-z0-9][A-Za-z0-9._-]*)*$"
              }
            },
            "manifestSha256": {
              "type": "string"
            }
          },
          "allOf": [
            {
              "if": {
                "properties": { "enabled": { "const": true } },
                "required": ["enabled"]
              },
              "then": {
                "properties": {
                  "existingSecret": { "minLength": 1 },
                  "manifest": { "minProperties": 1 },
                  "manifestSha256": {
                    "pattern": "^sha256:[a-f0-9]{64}$"
                  }
                }
              },
              "else": {
                "properties": {
                  "existingSecret": { "maxLength": 0 },
                  "manifest": { "maxProperties": 0 },
                  "manifestSha256": { "maxLength": 0 }
                }
              }
            }
          ]
        }
      }
    },
    "secretAuthority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["existingSecrets", "keys"],
      "properties": {
        "existingSecrets": {
          "type": "object",
          "additionalProperties": false,
          "required": ["platform", "tenant-kms", "tenant-as", "did", "blob", "issuer", "verifier", "wallet-unit", "wallet-interaction"],
          "properties": {
            "platform": { "type": "string" },
            "tenant-kms": { "type": "string" },
            "tenant-as": { "type": "string" },
            "did": { "type": "string" },
            "blob": { "type": "string" },
            "issuer": { "type": "string" },
            "verifier": { "type": "string" },
            "wallet-unit": { "type": "string" },
            "wallet-interaction": { "type": "string" }
          }
        },
        "keys": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "centralPermitSigningKey",
            "centralAssertionVerificationKeys",
            "satelliteAssertionSigningKey",
            "satellitePermitVerificationKeys",
            "centralPermitPrivateKey",
            "centralPermitPublicKey",
            "satelliteAssertionPrivateKey",
            "assertionPublicKeys"
          ],
          "properties": {
            "centralPermitSigningKey": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,252}$" },
            "centralAssertionVerificationKeys": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,252}$" },
            "satelliteAssertionSigningKey": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,252}$" },
            "satellitePermitVerificationKeys": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,252}$" },
            "centralPermitPrivateKey": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,252}$" },
            "centralPermitPublicKey": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,252}$" },
            "satelliteAssertionPrivateKey": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,252}$" },
            "assertionPublicKeys": {
              "type": "object",
              "additionalProperties": false,
              "required": ["service-platform", "service-crypto", "service-data", "service-blob", "service-tenant-as", "service-oid4vci", "service-oid4vp", "service-wallet-unit", "service-wallet-interaction"],
              "properties": {
                "service-platform": { "type": "string", "minLength": 1 },
                "service-crypto": { "type": "string", "minLength": 1 },
                "service-data": { "type": "string", "minLength": 1 },
                "service-blob": { "type": "string", "minLength": 1 },
                "service-tenant-as": { "type": "string", "minLength": 1 },
                "service-oid4vci": { "type": "string", "minLength": 1 },
                "service-oid4vp": { "type": "string", "minLength": 1 },
                "service-wallet-unit": { "type": "string", "minLength": 1 },
                "service-wallet-interaction": { "type": "string", "minLength": 1 }
              }
            }
          }
        }
      }
    },
    "email": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "routing", "accounts", "allowedPrivateDestinations"],
      "properties": {
        "enabled": { "type": "boolean" },
        "routing": {
          "type": "object",
          "additionalProperties": false,
          "required": ["defaultAccountId"],
          "properties": {
            "defaultAccountId": { "type": "string", "minLength": 1 }
          }
        },
        "accounts": {
          "type": "object",
          "additionalProperties": false,
          "required": ["default"],
          "properties": {
            "default": {
              "type": "object",
              "additionalProperties": false,
              "required": ["transportId", "fromAddress", "fromName", "replyTo", "smtp"],
              "properties": {
                "transportId": { "type": "string", "minLength": 1 },
                "fromAddress": { "type": "string" },
                "fromName": { "type": "string" },
                "replyTo": { "type": "string" },
                "smtp": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["host", "port", "username", "useStarttls", "useSsl", "connectionTimeoutMs", "readTimeoutMs"],
                  "properties": {
                    "host": { "type": "string" },
                    "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
                    "username": { "type": "string" },
                    "useStarttls": { "type": "boolean" },
                    "useSsl": { "type": "boolean" },
                    "connectionTimeoutMs": { "type": "integer", "minimum": 1 },
                    "readTimeoutMs": { "type": "integer", "minimum": 1 }
                  }
                }
              }
            }
          }
        },
        "allowedPrivateDestinations": { "type": "string" }
      }
    },
    "auth": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "enabled": { "type": "boolean" },
        "jwt": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "enabled": { "type": "boolean" },
            "issuer": { "type": "string" },
            "jwksUri": { "type": "string" },
            "audience": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "grpc": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "enabled": { "type": "boolean" },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "authMode": { "type": "string", "enum": ["service-jwt", "mesh-mtls", "none"] }
      }
    },
    "config": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "providers": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "platformConfigRemote": {
              "type": "object",
              "additionalProperties": true,
              "properties": {
                "enabled": { "type": "boolean" }
              }
            },
            "tenantConfigDb": {
              "type": "object",
              "additionalProperties": true,
              "properties": {
                "enabled": { "type": "boolean" }
              }
            }
          }
        }
      }
    },
    "platformKeystore": { "$ref": "#/definitions/keystorePersistence" },
    "tenantKmsKeystore": { "$ref": "#/definitions/keystorePersistence" },
    "walletInteractionKeystore": { "$ref": "#/definitions/keystorePersistence" },
    "blobPersistence": { "$ref": "#/definitions/keystorePersistence" },
    "platform": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "externalBaseUrl": { "type": "string", "minLength": 1 },
        "setup": {
          "type": "object",
          "additionalProperties": false,
          "required": ["licenseRequest"],
          "properties": {
            "licenseRequest": {
              "type": "object",
              "additionalProperties": false,
              "required": ["defaultAlias", "defaultAlgorithm", "defaultUse"],
              "properties": {
                "defaultAlias": { "type": "string", "minLength": 1 },
                "defaultAlgorithm": { "type": "string", "minLength": 1 },
                "defaultUse": { "type": "string", "minLength": 1 }
              }
            }
          }
        },
        "onboarding": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "deploymentId": { "type": "string", "minLength": 1 }
          }
        },
        "bootstrap": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "automatic": { "type": "boolean" },
            "issuer": { "type": "string", "minLength": 1 },
            "owner": {
              "type": "object",
              "additionalProperties": true,
              "properties": {
                "email": { "type": "string" },
                "displayName": { "type": "string", "minLength": 1 },
                "roles": { "type": "string" }
              }
            },
            "ownerInitialCredential": { "type": "string" },
            "userProviderMode": { "type": "string", "minLength": 1 },
            "deploymentMode": { "type": "string", "enum": ["dev", "prod"] }
          }
        }
      }
    },
    "serviceIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["clientIds", "serviceIds"],
      "properties": {
        "internalClientExistingSecret": { "type": "string" },
        "internalClientSecretKey": { "type": "string", "minLength": 1 },
        "clientIds": {
          "type": "object",
          "additionalProperties": true,
          "required": ["tenant-kms", "tenant-as", "did", "blob", "issuer", "verifier", "wallet-unit", "wallet-interaction"],
          "properties": {
            "tenant-kms": { "type": "string", "minLength": 1 },
            "tenant-as": { "type": "string", "minLength": 1 },
            "did": { "type": "string", "minLength": 1 },
            "blob": { "type": "string", "minLength": 1 },
            "issuer": { "type": "string", "minLength": 1 },
            "verifier": { "type": "string", "minLength": 1 },
            "wallet-unit": { "type": "string", "minLength": 1 },
            "wallet-interaction": { "type": "string", "minLength": 1 }
          }
        },
        "serviceIds": {
          "type": "object",
          "additionalProperties": true,
          "required": ["tenant-kms", "tenant-as", "did", "blob", "issuer", "verifier", "wallet-unit", "wallet-interaction"],
          "properties": {
            "tenant-kms": { "type": "string", "minLength": 1 },
            "tenant-as": { "type": "string", "minLength": 1 },
            "did": { "type": "string", "minLength": 1 },
            "blob": { "type": "string", "minLength": 1 },
            "issuer": { "type": "string", "minLength": 1 },
            "verifier": { "type": "string", "minLength": 1 },
            "wallet-unit": { "type": "string", "minLength": 1 },
            "wallet-interaction": { "type": "string", "minLength": 1 }
          }
        },
        "anonymousPathPrefixes": {
          "type": "object",
          "additionalProperties": false,
          "required": ["platform", "tenant-kms", "tenant-as", "did", "blob", "issuer", "verifier", "wallet-unit", "wallet-interaction"],
          "properties": {
            "platform": { "type": "string" },
            "tenant-kms": { "type": "string" },
            "tenant-as": { "type": "string" },
            "did": { "type": "string" },
            "blob": { "type": "string" },
            "issuer": { "type": "string" },
            "verifier": { "type": "string" },
            "wallet-unit": { "type": "string" },
            "wallet-interaction": { "type": "string" }
          }
        }
      }
    },
    "portalBff": {
      "type": "object",
      "additionalProperties": false,
      "required": ["clientId", "audience", "scope", "existingSecret", "clientSecretKey", "kms", "trustedIngress"],
      "properties": {
        "clientId": { "type": "string", "minLength": 1 },
        "audience": { "type": "string", "minLength": 1 },
        "scope": { "type": "string", "minLength": 1 },
        "existingSecret": { "type": "string" },
        "clientSecretKey": { "type": "string", "minLength": 1 },
        "kms": {
          "type": "object",
          "additionalProperties": false,
          "required": ["providerId", "encryptionKeyAlias", "handleHmacKeyAlias"],
          "properties": {
            "providerId": { "type": "string", "minLength": 1 },
            "encryptionKeyAlias": { "type": "string", "minLength": 1 },
            "handleHmacKeyAlias": { "type": "string", "minLength": 1 }
          }
        },
        "trustedIngress": {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode", "hops"],
          "properties": {
            "mode": { "type": "string", "enum": ["X_FORWARDED", "FORWARDED"] },
            "hops": { "type": "integer", "minimum": 1 }
          }
        }
      }
    },
    "keystore": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "existingSecret": { "type": "string" },
        "passwordKey": { "type": "string", "minLength": 1 }
      }
    },
    "issuerPipeline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["existingSecret", "masterKekKey", "blindIndexKey"],
      "properties": {
        "existingSecret": { "type": "string" },
        "masterKekKey": { "type": "string", "minLength": 1 },
        "blindIndexKey": { "type": "string", "minLength": 1 }
      }
    },
    "license": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "installationId": {
          "type": "string",
          "anyOf": [
            { "const": "" },
            { "format": "uuid" }
          ]
        },
        "commandEnforcement": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "enabled": { "type": "boolean" },
            "missingDescriptorMode": { "type": "string", "enum": ["warn", "deny"] }
          }
        },
        "serviceRoles": {
          "type": "object",
          "additionalProperties": { "type": "string", "minLength": 1 }
        },
        "trust": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "existingSecret": { "type": "string" },
            "rootCaKey": { "type": "string", "minLength": 1 },
            "rootCaPath": { "type": "string", "minLength": 1 },
            "embeddedEnabled": { "type": "boolean" }
          }
        }
      }
    },
    "serviceAccount": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "create": { "type": "boolean" },
        "name": { "type": "string" },
        "annotations": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "platform": {
          "type": "object",
          "additionalProperties": false,
          "required": ["create", "name", "annotations"],
          "properties": {
            "create": { "type": "boolean" },
            "name": { "type": "string" },
            "annotations": {
              "type": "object",
              "additionalProperties": { "type": "string" }
            }
          }
        }
      }
    },
    "networkPolicy": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "enabled": { "type": "boolean" },
        "allowDnsEgress": { "type": "boolean" },
        "secretProviderEgress": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled", "namespaceSelector", "podSelector", "ipBlocks", "ports"],
          "properties": {
            "enabled": { "type": "boolean" },
            "namespaceSelector": { "type": "object" },
            "podSelector": { "type": "object" },
            "ipBlocks": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["cidr"],
                "properties": {
                  "cidr": { "type": "string", "minLength": 1 },
                  "except": {
                    "type": "array",
                    "items": { "type": "string", "minLength": 1 }
                  }
                }
              }
            },
            "ports": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "integer",
                "minimum": 1,
                "maximum": 65535
              }
            }
          }
        },
        "ingressController": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "enabled": { "type": "boolean" },
            "namespaceSelector": { "type": "object" },
            "podSelector": { "type": "object" }
          }
        },
        "metricsScraper": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "enabled": { "type": "boolean" },
            "namespaceSelector": { "type": "object" },
            "podSelector": { "type": "object" }
          }
        }
      }
    },
    "serviceMonitor": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "enabled": { "type": "boolean" },
        "namespace": { "type": "string" },
        "labels": { "type": "object" },
        "interval": { "type": "string" },
        "scrapeTimeout": { "type": "string" },
        "path": { "type": "string", "pattern": "^/" }
      }
    },
    "opentelemetry": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "enabled": { "type": "boolean" },
        "endpoint": { "type": "string" },
        "protocol": { "type": "string" },
        "metricsExporter": { "type": "string" },
        "headers": { "type": "string" },
        "resourceAttributes": { "type": "string" }
      }
    },
    "podSecurityContext": { "type": "object" },
    "containerSecurityContext": { "type": "object" },
    "podAnnotations": { "type": "object" },
    "nodeSelector": { "type": "object" },
    "tolerations": { "type": "array" },
    "affinity": { "type": "object" },
    "ingress": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "legacy": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "enabled": { "type": "boolean" }
          }
        },
        "public": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "annotations": { "type": "object" }
          }
        },
        "internal": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "annotations": { "type": "object" }
          }
        }
      }
    },
    "gateway": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "enabled": { "type": "boolean" },
        "className": { "type": "string", "minLength": 1 },
        "infrastructureParametersRef": {
          "type": "object",
          "additionalProperties": false,
          "required": ["group", "kind", "name"],
          "properties": {
            "group": { "type": "string", "minLength": 1 },
            "kind": { "type": "string", "minLength": 1 },
            "name": { "type": "string" }
          }
        },
        "operatorHost": { "type": "string", "minLength": 1 },
        "baseDomain": { "type": "string" },
        "requestTimeout": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)(ms|s|m|h)$"
        },
        "backendRequestTimeout": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)(ms|s|m|h)$"
        },
        "httpRedirect": { "type": "boolean" },
        "tls": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "mode": { "type": "string", "enum": ["secret", "certManager", "external"] },
            "secretName": { "type": "string" },
            "clusterIssuer": { "type": "string" }
          }
        }
      }
    },
    "services": {
      "type": "object",
      "additionalProperties": false,
      "required": ["platform", "tenant-kms", "did", "blob", "tenant-as", "wallet-unit", "wallet-interaction", "issuer", "verifier"],
      "patternProperties": {
        "^(platform|tenant-kms|did|blob|tenant-as|wallet-unit|wallet-interaction|issuer|verifier|admin-console|admin-console-tenant)$": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "enabled": { "type": "boolean" },
            "image": { "type": "string", "minLength": 1 },
            "imageTag": { "type": "string", "minLength": 1 },
            "replicas": { "type": "integer", "minimum": 0 },
            "restPort": { "type": "integer", "minimum": 1, "maximum": 65535 },
            "publicIngress": { "$ref": "#/definitions/ingressBlock" },
            "internalIngress": { "$ref": "#/definitions/ingressBlock" },
            "resources": { "type": "object" },
            "env": { "type": "array" },
            "command": { "type": "array", "items": { "type": "string" } },
            "args": { "type": "array", "items": { "type": "string" } },
            "volumeMounts": { "type": "array", "items": { "type": "object" } },
            "volumes": { "type": "array", "items": { "type": "object" } }
          }
        }
      }
    }
  },
  "definitions": {
    "databaseEndpoint": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "host": { "type": "string", "minLength": 1 },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "name": { "type": "string", "minLength": 1 },
        "existingSecret": { "type": "string", "minLength": 1 },
        "usernameKey": { "type": "string", "minLength": 1 },
        "passwordKey": { "type": "string", "minLength": 1 }
      }
    },
    "keystorePersistence": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "enabled": { "type": "boolean" },
        "size": { "type": "string", "minLength": 1 },
        "storageClass": { "type": "string" },
        "existingClaim": { "type": "string" }
      }
    },
    "ingressBlock": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "enabled": { "type": "boolean" },
        "className": { "type": "string" },
        "host": { "type": "string" },
        "paths": {
          "type": "array",
          "items": { "type": "string", "pattern": "^/" }
        },
        "annotations": { "type": "object" }
      }
    }
  }
}
