{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "global": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "imageRegistry": {
          "type": "string",
          "minLength": 1,
          "not": {
            "pattern": "^(sphereon(?:/|$)|(?:docker\\.io|index\\.docker\\.io|registry-1\\.docker\\.io)(?:/|$))"
          }
        },
        "imageTag": { "type": "string", "minLength": 1 },
        "imagePullPolicy": { "type": "string", "enum": ["Always", "IfNotPresent", "Never"] },
        "imagePullSecrets": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "platformBaseDomain": { "type": "string", "minLength": 1 }
      }
    },
    "database": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "enabled": { "type": "boolean" },
        "dialect": { "type": "string", "enum": ["postgresql"] },
        "platform": { "$ref": "#/definitions/databaseEndpoint" },
        "maintenance": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "host": { "type": "string" },
            "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
            "database": { "type": "string", "minLength": 1 },
            "existingSecret": { "type": "string" },
            "usernameKey": { "type": "string", "minLength": 1 },
            "passwordKey": { "type": "string", "minLength": 1 }
          }
        },
        "tenant": {
          "allOf": [
            { "$ref": "#/definitions/databaseEndpoint" },
            {
              "type": "object",
              "additionalProperties": true,
              "properties": {
                "isolation": { "type": "string", "enum": ["schema", "shared", "database", "host"] },
                "schemaPattern": { "type": "string", "minLength": 1 },
                "databasePattern": { "type": "string", "minLength": 1 }
              }
            }
          ]
        }
      }
    },
    "auth": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "enabled": { "type": "boolean" },
        "jwt": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "enabled": { "type": "boolean" },
            "issuer": { "type": "string" },
            "jwksUri": { "type": "string" },
            "audience": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "grpc": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "enabled": { "type": "boolean" },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "authMode": { "type": "string", "enum": ["service-jwt", "mesh-mtls", "none"] }
      }
    },
    "config": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "providers": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "platformConfigRemote": {
              "type": "object",
              "additionalProperties": true,
              "properties": {
                "enabled": { "type": "boolean" }
              }
            },
            "tenantConfigDb": {
              "type": "object",
              "additionalProperties": true,
              "properties": {
                "enabled": { "type": "boolean" }
              }
            }
          }
        }
      }
    },
    "platformKeystore": { "$ref": "#/definitions/keystorePersistence" },
    "tenantKmsKeystore": { "$ref": "#/definitions/keystorePersistence" },
    "walletInteractionKeystore": { "$ref": "#/definitions/keystorePersistence" },
    "platform": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "bootstrap": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "issuer": { "type": "string", "minLength": 1 },
            "owner": {
              "type": "object",
              "additionalProperties": true,
              "properties": {
                "email": { "type": "string", "minLength": 1 },
                "displayName": { "type": "string", "minLength": 1 },
                "roles": { "type": "string" }
              }
            },
            "ownerInitialCredential": { "type": "string" },
            "userProviderMode": { "type": "string", "minLength": 1 },
            "deploymentMode": { "type": "string", "enum": ["dev", "prod"] }
          }
        }
      }
    },
    "serviceIdentity": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "internalClientExistingSecret": { "type": "string" },
        "internalClientSecretKey": { "type": "string", "minLength": 1 }
      }
    },
    "keystore": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "existingSecret": { "type": "string" },
        "passwordKey": { "type": "string", "minLength": 1 }
      }
    },
    "license": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "installationId": {
          "type": "string",
          "anyOf": [
            { "const": "" },
            { "format": "uuid" }
          ]
        },
        "commandEnforcement": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "enabled": { "type": "boolean" },
            "missingDescriptorMode": { "type": "string", "enum": ["warn", "deny"] }
          }
        },
        "serviceRoles": {
          "type": "object",
          "additionalProperties": { "type": "string", "minLength": 1 }
        },
        "trust": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "existingSecret": { "type": "string" },
            "rootCaKey": { "type": "string", "minLength": 1 },
            "rootCaPath": { "type": "string", "minLength": 1 },
            "embeddedEnabled": { "type": "boolean" }
          }
        }
      }
    },
    "serviceAccount": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "create": { "type": "boolean" },
        "name": { "type": "string" }
      }
    },
    "networkPolicy": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "enabled": { "type": "boolean" },
        "allowDnsEgress": { "type": "boolean" },
        "ingressController": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "enabled": { "type": "boolean" },
            "namespaceSelector": { "type": "object" },
            "podSelector": { "type": "object" }
          }
        },
        "metricsScraper": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "enabled": { "type": "boolean" },
            "namespaceSelector": { "type": "object" },
            "podSelector": { "type": "object" }
          }
        }
      }
    },
    "serviceMonitor": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "enabled": { "type": "boolean" },
        "namespace": { "type": "string" },
        "labels": { "type": "object" },
        "interval": { "type": "string" },
        "scrapeTimeout": { "type": "string" },
        "path": { "type": "string", "pattern": "^/" }
      }
    },
    "opentelemetry": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "enabled": { "type": "boolean" },
        "endpoint": { "type": "string" },
        "protocol": { "type": "string" },
        "headers": { "type": "string" },
        "resourceAttributes": { "type": "string" }
      }
    },
    "enableTenantConsole": { "type": "boolean" },
    "podSecurityContext": { "type": "object" },
    "containerSecurityContext": { "type": "object" },
    "podAnnotations": { "type": "object" },
    "nodeSelector": { "type": "object" },
    "tolerations": { "type": "array" },
    "affinity": { "type": "object" },
    "ingress": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "legacy": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "enabled": { "type": "boolean" }
          }
        },
        "public": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "annotations": { "type": "object" }
          }
        },
        "internal": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "annotations": { "type": "object" }
          }
        }
      }
    },
    "gateway": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "enabled": { "type": "boolean" },
        "className": { "type": "string", "minLength": 1 },
        "operatorHost": { "type": "string", "minLength": 1 },
        "baseDomain": { "type": "string" },
        "httpRedirect": { "type": "boolean" },
        "tls": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "mode": { "type": "string", "enum": ["secret", "certManager"] },
            "secretName": { "type": "string" },
            "clusterIssuer": { "type": "string" }
          }
        }
      }
    },
    "services": {
      "type": "object",
      "additionalProperties": false,
      "required": ["platform", "tenant-kms", "did", "tenant-as", "wallet-unit", "wallet-interaction", "issuer", "verifier"],
      "patternProperties": {
        "^(platform|tenant-kms|did|tenant-as|wallet-unit|wallet-interaction|issuer|verifier|admin-console)$": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "enabled": { "type": "boolean" },
            "image": { "type": "string", "minLength": 1 },
            "replicas": { "type": "integer", "minimum": 0 },
            "restPort": { "type": "integer", "minimum": 1, "maximum": 65535 },
            "publicIngress": { "$ref": "#/definitions/ingressBlock" },
            "internalIngress": { "$ref": "#/definitions/ingressBlock" },
            "resources": { "type": "object" },
            "env": { "type": "array" }
          }
        }
      }
    }
  },
  "definitions": {
    "databaseEndpoint": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "host": { "type": "string", "minLength": 1 },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "name": { "type": "string", "minLength": 1 },
        "existingSecret": { "type": "string", "minLength": 1 },
        "usernameKey": { "type": "string", "minLength": 1 },
        "passwordKey": { "type": "string", "minLength": 1 }
      }
    },
    "keystorePersistence": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "enabled": { "type": "boolean" },
        "size": { "type": "string", "minLength": 1 },
        "storageClass": { "type": "string" },
        "existingClaim": { "type": "string" }
      }
    },
    "ingressBlock": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "enabled": { "type": "boolean" },
        "className": { "type": "string" },
        "host": { "type": "string" },
        "paths": {
          "type": "array",
          "items": { "type": "string", "pattern": "^/" }
        },
        "annotations": { "type": "object" }
      }
    }
  }
}
